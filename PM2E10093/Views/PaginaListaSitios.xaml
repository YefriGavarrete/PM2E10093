<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PM2E10093.Views.PaginaListaSitios"
             Title="Sitios guardados">
    <Grid Padding="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <Button Text="Atras"
                HorizontalOptions="Start"
                Clicked="OnAtrasClicked" />

        <Label Grid.Row="1"
               Text="Sitios Guardados"
               Style="{StaticResource SubHeadline}"
               HorizontalOptions="Center" />

        <ListView x:Name="ListasMapas"
                  Grid.Row="2"
                  ItemSelected="ListasMapas_Selected"
                  ItemTapped="ListasMapas_Tapped"
                  HasUnevenRows="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="8"
                              ColumnDefinitions="72,*"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="10">
                            <Image Source="{Binding ImagenPath}"
                                   HeightRequest="56"
                                   WidthRequest="56"
                                   Aspect="AspectFill" />

                            <Label Grid.Column="1"
                                   Text="{Binding Descripcion}"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation" />

                            <Label Grid.Column="1"
                                   Grid.Row="1"
                                   Text="{Binding Latitud, StringFormat='Lat: {0:F6}'}"
                                   FontSize="12"
                                   TextColor="Gray" />

                            <Label Grid.Column="1"
                                   Grid.Row="2"
                                   Text="{Binding Longitud, StringFormat='Lng: {0:F6}'}"
                                   FontSize="12"
                                   TextColor="Gray" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3" RowDefinitions="Auto">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" Padding="5">
                <Button Text="Eliminar Casa"
                        BackgroundColor="Red"
                        WidthRequest="160"
                        TextColor="White"
                        Clicked="OnEliminarClicked" />

                <Button Text="Ver Mapa"
                        BackgroundColor="BlueViolet"
                        WidthRequest="160"
                        TextColor="White"
                        Clicked="OnMapaClicked" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
